---
import { Picture } from 'astro:assets';
import type { Project } from '../data/projects';
import Arrow from './Arrow.astro';

interface Props {
  project: Project;
  index: number;
  loading?: 'lazy' | 'eager';
}
const { project, index, loading = 'lazy' } = Astro.props;
---

<article class="work-card" data-hscroll-card style={`--accent: ${project.accent}; --on-accent: ${project.onAccent}`}>
  <a href={`/work/${project.slug}/`} class="work-card__link" data-cursor-text="View">
    <div class="work-card__frame">
      <Picture
        src={project.image}
        alt={project.imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 900px) 60vw, 100vw"
        loading={loading}
        class="work-card__img"
      />
    </div>
    <div class="work-card__meta">
      <span class="label work-card__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h3 class="work-card__title">{project.name}</h3>
      <p class="work-card__sub muted">{project.trade}, {project.area}</p>
      {project.concept && <span class="work-card__tag label">Concept build</span>}
      <span class="work-card__go" aria-hidden="true"><Arrow direction="up-right" /></span>
    </div>
  </a>
</article>

<style>
  .work-card {
    min-width: 0;
  }

  .work-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    text-decoration: none;
    color: inherit;
  }

  .work-card__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-ink-soft);
    outline: 1px solid var(--line);
  }

  .work-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    opacity: 0;
    mix-blend-mode: multiply;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .work-card__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 1.1s var(--ease-out);
  }

  .work-card__link:hover .work-card__frame :global(img) {
    transform: scale(1.04);
  }

  .work-card__link:hover .work-card__frame::after {
    opacity: 0.18;
  }

  .work-card__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: var(--space-s);
    row-gap: 0.25rem;
  }

  .work-card__num {
    grid-row: span 2;
  }

  .work-card__title {
    min-width: 0;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .work-card__sub {
    grid-column: 2;
    font-size: var(--step--1);
  }

  .work-card__tag {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    font-size: 0.72rem;
  }

  .work-card__go {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    background: var(--color-signal);
    color: var(--color-ink);
    transition: transform var(--dur) var(--ease-out);
  }

  .work-card__go :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .work-card__link:hover .work-card__go {
    transform: rotate(45deg);
  }
</style>
