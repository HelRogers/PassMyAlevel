---
interface Props {
  class?: string;
  direction?: 'right' | 'up-right' | 'down';
}
const { class: className = 'btn__arrow', direction = 'right' } = Astro.props;
const rotate = { right: 0, 'up-right': -45, down: 90 }[direction];
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" focusable="false" style={rotate ? `rotate: ${rotate}deg` : undefined}>
  <path d="M4 12h15M13 6l6 6-6 6" />
</svg>
