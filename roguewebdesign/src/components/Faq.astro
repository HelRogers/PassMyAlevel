---
import { faqs } from '../data/services';

// FAQPage structured data helps these answers show in search results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div>
      <p class="label eyebrow">Questions</p>
      <h2 id="faq-title" class="h2" data-split>Things people ask</h2>
    </div>
    <div class="faq__list" data-reveal-group>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>
            <span class="faq__q">{f.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }

  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }

  .faq__list {
    border-top: 1px solid var(--color-ink);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-ink);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-m);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: transform var(--dur) var(--ease-out);
  }

  summary:hover .faq__q {
    transform: translateX(0.35rem);
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid currentColor;
    transition: background-color var(--dur), transform 0.5s var(--ease-out);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon {
    background: var(--color-signal);
    border-color: var(--color-signal);
    transform: rotate(180deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-bottom: var(--space-m);
    color: var(--fg-muted);
  }

  details[open] .faq__a {
    animation: faq-in 0.5s var(--ease-out);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>
